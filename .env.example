# ─── Neon (PostgreSQL) ────────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime (Neon dashboard → Connect → Node.js/Prisma).
# Recommended: add ?sslmode=require
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string used by the Prisma CLI (prisma migrate / db push / studio).
# Neon dashboard → Connect → Direct connection.
DIRECT_URL="postgresql://<user>:<password>@<host>.region.aws.neon.tech/neondb"

# ─── Vercel ────────────────────────────────────────────────────────────────────
# Your public site URL (set on deploy so social previews & OG images resolve correctly).
# Example: "https://skycast-xxxx.vercel.app" (or your custom domain).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate with `openssl rand -base64 48`.
AUTH_SECRET="change-me-to-a-long-random-string"

# ─── Admin bootstrap (prisma/seed.ts) ─────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin.123"